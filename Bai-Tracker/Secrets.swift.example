import Foundation

// ---------------------------------------------------------------------------
// TEMPLATE — copy this file to `Secrets.swift` (same folder) and fill in your
// key. `Secrets.swift` is git-ignored so real credentials stay out of the repo.
//
//     cp Bai-Tracker/Secrets.swift.example Bai-Tracker/Secrets.swift
//
// The project already expects `Secrets.swift` to exist, so the build fails
// with "Build input file cannot be found" until you create it.
// ---------------------------------------------------------------------------

enum Secrets {

    /// Google Cloud API key.
    ///
    /// Needs both APIs enabled for the app to work:
    /// - **Maps SDK for iOS** — the map itself
    /// - **Places API (New)** — project-location autocomplete
    ///
    /// If you restrict the key to iOS apps, allow bundle ID
    /// `com.bai-eng.tracker`.
    static let googleAPIKey = "YOUR_GOOGLE_API_KEY_HERE"
}
